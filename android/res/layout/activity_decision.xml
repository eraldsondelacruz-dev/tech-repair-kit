<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screenBackground"
    android:fillViewport="true"
    tools:context=".DecisionActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/decision_intro"
            android:textColor="@color/textSecondary"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <CheckBox
                    android:id="@+id/goalRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Root access (e.g. Magisk)" />

                <CheckBox
                    android:id="@+id/goalRom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Install a custom ROM or GSI" />

                <CheckBox
                    android:id="@+id/goalKernel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Install a custom kernel" />

                <CheckBox
                    android:id="@+id/goalRecovery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Install custom recovery (TWRP)" />

                <CheckBox
                    android:id="@+id/goalBloat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Remove system apps / bloatware" />

                <CheckBox
                    android:id="@+id/goalPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Advanced privacy control / ad-blocking" />

                <CheckBox
                    android:id="@+id/goalDev"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="App or kernel development &amp; testing" />

                <CheckBox
                    android:id="@+id/goalCurious"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Just curious / want to try it" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/evaluateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_evaluate" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/resultCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/decision_result_title" />

                <TextView
                    android:id="@+id/verdictText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Worth it" />

                <TextView
                    android:id="@+id/verdictExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp"
                    tools:text="Based on your goals..." />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFF7E0"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/risk_title" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="4dp"
                    android:text="- Unlocking wipes ALL your data (including internal storage).\n- Your warranty may be voided.\n- Banking, payment, and some streaming apps may stop working (SafetyNet/Play Integrity).\n- Official OTA updates may no longer install.\n- A wrong step can brick the device."
                    android:textColor="@color/textSecondary"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
