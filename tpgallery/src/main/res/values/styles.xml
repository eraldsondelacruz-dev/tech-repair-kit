<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TPTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/textMain</item>
        <item name="android:textColorSecondary">@color/textDim</item>
    </style>

    <style name="TPButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/textMain</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
